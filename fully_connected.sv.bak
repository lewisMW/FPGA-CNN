
module fully_connected #(
    parameter int BITS_N,
    parameter int INPUT_NEURONS,
    parameter int OUTPUT_NEURONS,
    parameter int INPUT_STRIDE,
    parameter logic signed [INPUT_NEURONS-1:0][OUTPUT_NEURONS-1:0] WEIGHTS 
) (
    input clk,
    input rst,
    input [INPUT_STRIDE-1:0][BITS_N-1:0] data_in,
    input [INPUT_STRIDE-1:0] i_valid,
    output i_ready,
    output [OUTPUT_NEURONS-1:0][BITS_N-1:0] data_out,
    output logic o_valid
);

    logic [OUTPUT_NEURONS-1:0][BITS_N-1:0] out_neurons;
    
    logic [$clog2(INPUT_NEURONS)-1:0] input_count;
    logic [$clog2(INPUT_STRIDE)-1:0] input_select;
    assign input_select = input_count[$clog2(INPUT_STRIDE)-1:0]; 
    logic signed [BITS_N-1:0] operand_q;

    logic signed [BITS_N-1:0] result;

    always_ff @( posedge clk ) begin 
        if (i_valid[input_select]) begin
            operand_q <= data_in[input_select];
            input_count <= input_count < INPUT_NEURONS - 1 ? input_count + 1 : '0;
        end
        out_neurons[input_count-1] <= result; // ?
        o_valid <= input_count == INPUT_NEURONS - 1;
    end

    always_comb begin 
        result = '0;
        for (int i = 0; i < OUTPUT_NEURONS; i++) begin
            result = result + operand_q * WEIGHTS[input_count-1][i];
            //TODO truncation and signs
        end
    end
 
    assign i_ready = 1'b1;
    assign data_out = out_neurons;
    
endmodule